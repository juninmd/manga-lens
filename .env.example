# --- servidor ---
PORT=7788

# --- LLM (OpenAI-compatible: Ollama, LiteLLM, vLLM, LM Studio...) ---
# Ollama local:
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b-instruct
# Modelo com visao (opcional). Se definido, habilita traducao direto da imagem
# sem depender do OCR (util para furigana / texto vertical estilizado).
AI_VISION_MODEL=

# Exemplo LiteLLM do cluster:
# AI_BASE_URL=https://litellm.antonio-code.duckdns.org/v1
# AI_API_KEY=sk-...
# AI_MODEL=cloud/llama-8b

# Modelos de raciocinio (gpt-oss-*) precisam de folga, nunca use max_tokens baixo.
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=120000

# --- providers extras baseados no tema Madara (WordPress) ---
# Um parser atende qualquer site Madara. Formato: id|Nome|https://site|idioma
# separados por ';'. MangaRead ja' vem embutido.
MADARA_SITES=

# --- provider local (CBZ / pastas de imagens) ---
# Aceita varios caminhos separados por ';'
LOCAL_LIBRARY=D:\\Quadrinhos

# --- cache ---
CACHE_DIR=.cache
CACHE_TTL_MS=1800000
