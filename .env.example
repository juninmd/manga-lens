# ==============================================================================
# MangaLens - Variáveis de Ambiente
# ==============================================================================

PORT=7788
LOCAL_LIBRARY=

# ------------------------------------------------------------------------------
# Configuração do Provedor de IA (AI SDK)
# Opções: ollama | openrouter | openaicompatible (padrão: ollama)
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=120000

# 1) Ollama (Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=

# 2) OpenRouter (Nuvem)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=

# 3) OpenAI Compatible (LM Studio, vLLM, LiteLLM, Groq, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct
OPENAI_COMPATIBLE_VISION_MODEL=

# Configuração genérica retrocompatível (caso não use as específicas acima)
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b-instruct
AI_VISION_MODEL=

# Fontes Madara adicionais (campos finais opcionais; lista completa: docs/sources.md)
# MADARA_SITES=id|Nome|https://origem|pt-br|hq|comic|cdn.exemplo.org

# Catalogos OPDS: Komga, Kavita, Calibre/Calibre-Web (credencial, tipo e idioma opcionais)
# OPDS_CATALOGS=komga|Minha Komga|http://192.168.0.10:25600/opds/v1.2/catalog|usuario:senha|hq|en

# ------------------------------------------------------------------------------
# Leitura em voz alta (leitor de livro). Local por padrao; tudo editavel no painel "⚙ voz".
# ------------------------------------------------------------------------------
# Kokoro-FastAPI: docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
KOKORO_BASE_URL=http://127.0.0.1:8880/v1
KOKORO_VOICE=pf_dora
# Piper: pip install "piper-tts[http]" && python -m piper.download_voices pt_BR-faber-medium && python -m piper.http_server -m pt_BR-faber-medium
PIPER_BASE_URL=http://127.0.0.1:5000
PIPER_VOICE=pt_BR-faber-medium
# SaaS (opcionais)
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_VOICE=pt-BR-FranciscaNeural
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=pt-BR-Neural2-A
