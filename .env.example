# ==============================================================================
# MangaLens - Variáveis de Ambiente
# ==============================================================================

PORT=7788
LOCAL_LIBRARY=

# ------------------------------------------------------------------------------
# Configuração do Provedor de IA (AI SDK)
# Opções: ollama | openrouter | openaicompatible (padrão: ollama)
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama
AI_MAX_TOKENS=1200
AI_TIMEOUT_MS=120000

# 1) Ollama (Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=

# 2) OpenRouter (Nuvem)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=

# 3) OpenAI Compatible (LM Studio, vLLM, LiteLLM, Groq, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=qwen2.5:7b-instruct
OPENAI_COMPATIBLE_VISION_MODEL=

# Configuração genérica retrocompatível (caso não use as específicas acima)
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b-instruct
AI_VISION_MODEL=
