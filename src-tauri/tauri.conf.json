{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaLens",
  "version": "0.1.0",
  "identifier": "com.junin.mangalens",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "bun run build:desktop",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MangaLens",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/manga-lens-server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
