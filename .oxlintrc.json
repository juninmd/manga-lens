{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/no-new-array": "off"
  },
  "ignorePatterns": ["public/**", "node_modules/**", "src-tauri/**", ".cache/**", ".testlib/**"],
  "env": {
    "browser": true,
    "es2024": true
  }
}
