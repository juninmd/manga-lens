{
  "name": "manga-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --watch src/server/index.ts",
    "start": "bun run build:client && bun src/server/index.ts",
    "build:client": "bun run scripts/build-client.ts",
    "lint": "oxlint --deny-warnings src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check": "bun run lint && bun run typecheck && bun run test",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:canvas": "node scripts/canvas-fit-check.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
    "build:desktop": "bun run build:client && bun run build:sidecar",
    "icons": "bun run scripts/make-icon.mjs && tauri icon src-tauri/icon-source.png",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.83",
    "hono": "^4.6.14",
    "onnxruntime-web": "1.30.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "oxlint": "1.80.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2"
  }
}
